<?xml version="1.0" encoding="UTF-8"?>
<!-- NetBeans Platform Build Script -->
<project name="GestiondeGrafos-impl" basedir="..">
    <property name="src.dir" value="src"/>
    <property name="build.classes.dir" value="build/classes"/>
    <property name="dist.dir" value="dist"/>
    <property name="dist.jar" value="${dist.dir}/GestionGrafos.jar"/>
    <property name="main.class" value="gestiondegrafos.VentanaPrincipal"/>

    <target name="compile">
        <mkdir dir="${build.classes.dir}"/>
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}" includeantruntime="false"/>
    </target>

    <target name="jar" depends="compile">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
            </manifest>
        </jar>
    </target>

    <target name="run" depends="jar">
        <java jar="${dist.jar}" fork="true"/>
    </target>

    <target name="clean">
        <delete dir="build"/>
        <delete dir="${dist.dir}"/>
    </target>
</project>
